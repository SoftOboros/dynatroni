[Unit]
Description=Fetch PostgreSQL secrets from SSM Parameter Store
After=network-online.target
Wants=network-online.target
Before=postgresql@16-main.service dumbo-configure-pg.service dumbo-init.service dumbo-pgbouncer.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dumbo-fetch-secrets.sh /etc/default/dumbo-secrets
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
